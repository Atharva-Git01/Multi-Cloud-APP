# Copy this to .env and fill in real values before running

DATABASE_URL=postgresql+asyncpg://bbg:bbg@localhost/bbgcloud
REDIS_URL=redis://localhost:6379

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-in-prod
ENCRYPTION_KEY=change-me-in-prod

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Drive (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OneDrive (Microsoft Graph)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:8000/api/auth/onedrive/callback

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# pCloud
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=

# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# CORS (comma-separated or * for dev)
CORS_ORIGINS=*
