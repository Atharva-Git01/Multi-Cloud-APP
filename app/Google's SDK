import * as AuthSession from "expo-auth-session";
import * as WebBrowser from "expo-web-browser";

WebBrowser.maybeCompleteAuthSession();

const CLIENT_ID = "YOUR_ANDROID_OR_IOS_CLIENT_ID";
const REDIRECT_URI = AuthSession.makeRedirectUri({
  scheme: "com.yourapp",
});

const [request, response, promptAsync] = AuthSession.useAuthRequest(
  {
    clientId: CLIENT_ID,
    scopes: ["https://www.googleapis.com/auth/drive.file", "profile", "email"],
    redirectUri: REDIRECT_URI,
  },
  { authorizationEndpoint: "https://accounts.google.com/o/oauth2/v2/auth" }
);

// When user taps "Login with Google"
async function signInWithGoogle() {
  const result = await promptAsync();
  if (result?.type === "success") {
    const code = result.params.code;

    // send the code to your FastAPI backend:
    await fetch("https://your-backend.com/api/google/mobile_callback", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ code }),
    });
  }
}
